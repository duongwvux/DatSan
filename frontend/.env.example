# Sao chép thành .env.local để dùng khi dev. Không commit .env.local.

# Bật mock API (MSW) để làm frontend khi backend chưa có endpoint.
VITE_ENABLE_MOCKS=true

# Địa chỉ backend Spring Boot cho Vite dev proxy (/api, /oauth2, /ws).
VITE_BACKEND_URL=http://localhost:8080

# Mặc định gọi cùng origin qua proxy. Chỉ đổi khi deploy frontend và backend khác domain.
# VITE_API_BASE_URL=/api/v1
# VITE_WS_URL=/ws
